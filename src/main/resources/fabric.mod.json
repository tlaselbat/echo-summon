{
	"schemaVersion": 1,
	"id": "echo_summon",
	"version": "${version}",
	"name": "ClickMC: Echo Summon",
	"description": "Summon, bind, and manage mounts via saddle and harness tools.",
	"authors": ["TabletMC"],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/TabletMC/Echo-Summon"
	},
	"license": "CC0-1.0",
	"environment": "*",
	"entrypoints": {
		"client": ["com.tabletmc.echo_summon.ClientInitializer"],
		"main": ["com.tabletmc.echo_summon.ModInitializer"],
		"modmenu": ["com.tabletmc.echo_summon.compat.ModMenuIntegration"]
	},
	"mixins": ["echo_summon.mixins.json"],
	"accessWidener": "echo_summon.accesswidener",
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"fabric-api": ">=${fabric_version}",
		"java": ">=21"
